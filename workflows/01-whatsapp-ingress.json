{
  "id": "salesflow-wf-01",
  "name": "SalesFlow 01 WhatsApp Ingress",
  "active": false,
  "nodes": [
    {
      "id": "trigger",
      "name": "Authenticated Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "salesflow-inbound",
      "position": [0, 0],
      "parameters": {"httpMethod": "POST", "path": "salesflow/inbound", "responseMode": "lastNode"}
    },
    {
      "id": "ingest",
      "name": "Atomic Ingest",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 0],
      "credentials": {"postgres": {"id": "salesflow-postgres-local", "name": "SalesFlow PostgreSQL"}},
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH x AS (SELECT salesflow.ingest($1,$2::jsonb) result) SELECT result,$1::text token,result->>'account_ref' account_ref FROM x",
        "options": {"queryReplacement": "={{ [$json.headers['x-salesflow-token'] || '', JSON.stringify($json.body || {})] }}"}
      }
    },
    {
      "id": "accepted",
      "name": "Accepted and Created",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "parameters": {"conditions": {"options": {"caseSensitive": true}, "combinator": "and", "conditions": [{"leftValue": "={{$json.result.accepted === true && $json.result.created === true}}", "operator": {"type": "boolean", "operation": "true", "singleValue": true}}]}}
    },
    {
      "id": "orchestrate",
      "name": "Run Orchestrator",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [660, -80],
      "parameters": {"workflowId": {"__rl": true, "value": "salesflow-wf-02", "mode": "id"}, "options": {"waitForSubWorkflow": true}}
    },
    {"id": "rejected", "name": "Typed Terminal", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [660, 80], "parameters": {}}
  ],
  "connections": {
    "Authenticated Inbound": {"main": [[{"node": "Atomic Ingest", "type": "main", "index": 0}]]},
    "Atomic Ingest": {"main": [[{"node": "Accepted and Created", "type": "main", "index": 0}]]},
    "Accepted and Created": {"main": [[{"node": "Run Orchestrator", "type": "main", "index": 0}], [{"node": "Typed Terminal", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "saveDataSuccessExecution": "none", "saveDataErrorExecution": "none", "saveManualExecutions": false}
}
